# Multi-Provider AI Credentials for Resume Builder
# At least one provider key is recommended; offline mode works with no keys.

# 1. Google Gemini API (Primary)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Groq API (High-speed free tier)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# 3. Cohere API (Trial / Free tier available)
# Get key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# 4. OpenRouter API (Access to free and open models)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 5. Cloudflare Workers AI
# Get token & account ID: https://dash.cloudflare.com/
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
