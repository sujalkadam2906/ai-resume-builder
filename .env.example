# ==============================================================================
# AI Resume Builder Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for local development or production.
# NEVER commit your actual .env file to version control.

# ------------------------------------------------------------------------------
# 1. Server & Application Settings
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=AI Resume Builder Platform API
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16 Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=resume_builder
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/resume_builder

# ------------------------------------------------------------------------------
# 3. Storage & Document Persistence
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. Zero-Trust Cloudflare Access Security Gate
# ------------------------------------------------------------------------------
CF_ACCESS_TEAM_NAME=
CF_ACCESS_AUD=
REQUIRE_CF_ACCESS=false
ALLOW_DEV_AUTH_BYPASS=true
ALLOWED_EMAILS=

# ------------------------------------------------------------------------------
# 5. Rate Limiting Settings
# ------------------------------------------------------------------------------
RATE_LIMIT_GENERATION_PER_MINUTE=10
RATE_LIMIT_ANALYSIS_PER_MINUTE=15
RATE_LIMIT_EXPORT_PER_MINUTE=20

# ------------------------------------------------------------------------------
# 6. Multi-Provider AI Credentials (At least one recommended)
# ------------------------------------------------------------------------------
# 1. Google Gemini API (Primary) - https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Groq API (High-speed free tier) - https://console.groq.com/keys
GROQ_API_KEY=

# 3. Cohere API (Trial / Free tier) - https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# 4. OpenRouter API (Access to open models) - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 5. Cloudflare Workers AI - https://dash.cloudflare.com/
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
